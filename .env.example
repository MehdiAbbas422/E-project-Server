# ---- Server ----
# Port the API/Socket.IO server listens on (Render/Railway inject their own).
PORT=5000

# MongoDB connection string (local or MongoDB Atlas). Replace with your own.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/eventsphere?retryWrites=true&w=majority

# REQUIRED: long random string used to sign JWT tokens.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret

# Base URL of the React client (used for CORS + Socket.IO + email links).
# Dev: http://localhost:3000   |   Prod: https://your-frontend.vercel.app
CLIENT_URL=http://localhost:3000

# Extra code required to register an admin after the first one already exists.
ADMIN_SIGNUP_CODE=change-me

# ---- Email / OTP (optional) ----
# Leave SMTP_HOST empty to use a free Ethereal test inbox (the OTP preview link
# is printed in the server console instead of being emailed).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ---- Client ----
# Copy the values below into client/.env.local (dev) or the Vercel dashboard.
# VITE_API_URL=https://your-backend.onrender.com/api
# VITE_SOCKET_URL=https://your-backend.onrender.com
