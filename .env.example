# ---- Server ----
# Port the local API server listens on (Vercel/Render/Railway inject their own).
PORT=5000

# MongoDB connection string (local or MongoDB Atlas). Replace with your own.
MONGO_URI=mongodb+srv://mehdi123:mehdi123@<cluster-host>/eventsphere?retryWrites=true&w=majority

# REQUIRED: long random string used to sign JWT tokens.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret

# Base URL of the React client (used for CORS + email links).
# Dev: http://localhost:3000   |   Prod: https://your-frontend.vercel.app
CLIENT_URL=https://e-project-cliect-8xca8podk-zeny3.vercel.app/

# Extra code required to register an admin after the first one already exists.
ADMIN_SIGNUP_CODE=change-me

# ---- Email / OTP (optional) ----
# Leave SMTP_HOST empty to use a free Ethereal test inbox (the OTP preview link
# is printed in the server console instead of being emailed).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER='movieshow920@gmail.com'
SMTP_PASS='yyqj ksdl psim rklq'
SMTP_FROM='movieshow920@gmail.com'

